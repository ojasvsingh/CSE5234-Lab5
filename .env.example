# Optional: copy to .env. These defaults match the LOCAL Docker database.
# Never use these sample passwords for RDS. Never prefix secrets with VITE_.
DB_HOST=127.0.0.1
DB_PORT=33306
DB_NAME=adventure_beyond
DB_USER=adventure
DB_PASSWORD=local-demo-password
DB_ROOT_PASSWORD=local-root-password
DB_SSL=false
# Separate local databases for the payment institution and the carrier.
PAYMENT_DB_NAME=adventure_payment
PAYMENT_DB_HOST=127.0.0.1
PAYMENT_DB_PORT=33306
PAYMENT_DB_USER=adventure_payment
PAYMENT_DB_PASSWORD=local-payment-password
PAYMENT_DB_SSL=false
SHIPPING_DB_NAME=adventure_shipping
SHIPPING_DB_HOST=127.0.0.1
SHIPPING_DB_PORT=33306
SHIPPING_DB_USER=adventure_shipping
SHIPPING_DB_PASSWORD=local-shipping-password
SHIPPING_DB_SSL=false
STORE_BUSINESS_ID=AB-STORE-1001
PARTNER_MODE=local
EVENT_TRANSPORT=local
# Local mode simulates the event bus and SNS using ignored files plus a subscriber.
# AWS mode is configured by lab9:setup / lab9:deploy in ignored .env.lab9.
# PAYMENT_SERVICE_URL=https://payment-api.example/dev
# EVENT_BUS_NAME=adventure-beyond-lab9-orders
# RDS_AWS_PROFILE=school
# RDS_AWS_REGION=us-east-1
# For RDS: set host/port/user/password and DB_SSL=rds.
# For other TLS databases: DB_SSL=true and optionally DB_SSL_CA=/path/to/ca.pem.

# Optional deployed API addresses. Public values only.
# Base invoke URL INCLUDING /dev, WITHOUT the endpoint path.
VITE_INVENTORY_API_URL=
VITE_ORDER_API_URL=
