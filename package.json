{
  "name": "adventure-beyond",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adventure Beyond storefront with inventory and order microservices for CSE 5234 Labs 5–7",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js tests/api/*.test.js",
    "test:e2e": "playwright test",
    "dev:frontend": "vite",
    "dev:services": "node scripts/dev.mjs --services-only",
    "start:inventory": "node services/inventory/server.js",
    "start:orders": "node services/orders/server.js",
    "preview:all": "node scripts/dev.mjs --preview",
    "test:api": "node --test tests/api/*.test.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  }
}
