{
  "name": "adventure-beyond",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adventure Beyond storefront with inventory, order, payment, and shipping services for CSE 5234 Labs 5–9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:rds": "node --env-file=.env.rds scripts/dev.mjs",
    "dev:aws": "node --env-file=.env.lab9 scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js tests/api/*.test.js",
    "test:e2e": "playwright test",
    "dev:frontend": "vite",
    "dev:services": "node scripts/dev.mjs --services-only",
    "start:inventory": "node services/inventory/server.js",
    "start:orders": "node services/orders/server.js",
    "start:payment": "node services/payment/server.js",
    "start:shipping": "node services/shipping/server.js",
    "start:publisher": "node services/orders/worker.js",
    "lab9:setup": "node scripts/lab9.mjs setup",
    "lab9:deploy": "node scripts/lab9.mjs deploy",
    "lab9:inspect": "node scripts/lab9.mjs inspect",
    "lab9:inspect:aws": "node scripts/lab9.mjs inspect --aws",
    "lab9:capture": "node scripts/capture-lab9.mjs",
    "lab9:capture:aws": "node scripts/capture-lab9.mjs --aws",
    "preview:all": "node scripts/dev.mjs --preview",
    "test:api": "node --test tests/api/*.test.js",
    "postinstall": "npm ci --prefix services",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:init": "node scripts/database.mjs",
    "db:test:up": "docker compose --profile test up -d --wait test-db",
    "test:unit": "node --test tests/unit/*.test.js",
    "db:inspect": "node scripts/inspect-database.mjs",
    "rds:setup": "node scripts/rds.mjs setup",
    "rds:inspect": "node scripts/rds.mjs inspect",
    "rds:manual": "node scripts/rds.mjs manual"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  }
}
